{
  "uid": "b1-architecture",
  "title": "B1 Evidencias arquiteturais",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "IA com fallback",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "b1_ia_calls_total{outcome=\"fallback\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Eventos pendentes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "b1_outbox_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tentativas de notificacao com falha",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "b1_outbox_attempts_total{outcome=\"failed\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Eventos IoT aceitos ou duplicados",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "b1_iot_received_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latencia HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[2m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Core disponivel",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "b1-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "up{job=\"b1-core\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
